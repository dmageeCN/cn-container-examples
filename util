#!/usr/bin/env bash

## util is only ever sourced by build.sh/run.sh (root dispatchers) or by an
## examples/<test>/*.sh script running standalone. Either caller guarantees
## ROOT_DIR is already set before sourcing this file.

export SRC_DIR=${ROOT_DIR}/src/${NAME}
export IMAGE_DIR=${ROOT_DIR}/image_files
export RESULTS_DIR=${ROOT_DIR}/results/${NAME}
export UTIL_SOURCED=1
export THEDATE=$(date +'%m-%d_%H-%M')

gcl() {
    git clone --recurse-submodules $1
}

get_pkgs() {
    while [[ $# -gt 0 ]]; do
        pkg=$1
        bname=$(basename $pkg .git)
        ext="${pkg##*.}"
        if [[ ! (-e ${PWD}/${bname}) ]]; then
            if [[ $ext == 'git' ]]; then
                echo "CLONING $pkg - ${PWD}"
                gcl $pkg
            else
                echo "GETTING $pkg - ${PWD}"
                wget $pkg
            fi
#        else
#            if [[ $ext == 'git' ]]; then
#                cd ${SRC_DIR}/${bname}
#                git pull
#                cd ${SRC_DIR}
#            fi
        fi
        shift
    done
}

get_repo_home() {
    curdir=$(realpath $1)
    if [[ -d $curdir/.git ]]; then
        echo $curdir
        return 0
    fi
    top_dir=$(dirname $curdir)
    if [[ -d $top_dir/.git ]]; then
        echo $top_dir
    else
        get_repo_home $top_dir
    fi
}

empath() {
	if [[ $# -lt 1 ]]
	then
		echo $PATH | tr : "\n" | nl -n ln
	else
		if [[ $# -lt 2 ]]
		then
			echo $1 | tr : "\n" | nl -n ln
		else
			echo $1 | tr $2 "\n" | nl -n ln
		fi
	fi
}

mkcd() {
    mkdir -p "${1}" && cd "${1}"
}

setvar() {
    while [[ $# -gt 0 ]]; do
        export $1
        shift
    done
}

pq_grid() {
    local n=$1
    awk -v n="$n" 'BEGIN{
        p = int(sqrt(n))
        while (p > 1 && n % p != 0) p--
        print p
    }'
}

set_paths() {
    type=$1
    image_str="cn-${NAME}-${type}"
    export HOST_INSTALL=${ROOT_DIR}/install/${type}
    ## Default to the system libfabric (/usr, whatever dnf/apt installed --
    ## this repo is public, so most users won't have access to Cornelis'
    ## internal libfabric build and will rely on their distro's OPX-enabled
    ## package). Callers who DO have access to a custom libfabric build
    ## (e.g. installed to HOST_INSTALL/libfabric-${type}) can override this
    ## from the command line: OFI_HOME=... (setvar exports it before
    ## set_paths runs, so the default below only applies if it's still unset).
    export MPI_HOME=${HOST_INSTALL}/openmpi-5.0.8

    export PATH=${MPI_HOME}/bin:$PATH
    export LD_LIBRARY_PATH=${MPI_HOME}/lib:$LD_LIBRARY_PATH
    export CTR_IMAGE="${IMAGE_DIR}/${image_str}_v${VER}.sif"
    if [[ ! (-f $CTR_IMAGE) ]]; then
        echo "There is no image for ${NAME} of this type=${TYPE}."
        echo "Requested image: $CTR_IMAGE"
        exit 1
    fi
}

get_gpu_arch() {
    if [[ $1 == "nvidia" ]]; then
        nvidia-smi --query-gpu=compute_cap --format=csv,noheader,nounits | head -1 | tr -d '.'
    elif [[ $1 == "amd" ]]; then
        rocminfo | awk -F'gfx' '/gfx[0-9]/ {print "gfx"$2; exit}'
    else
        echo "NO GPU HERE - EXIT"
        exit 1
    fi
}

## detect_gpu sets/exports TYPE (cpu|amd|nvidia).
##
## - If TYPE was already validated earlier in this process tree (TYPE_VALIDATED
##   is set, e.g. by the root build.sh/run.sh dispatcher or an earlier call in
##   this same script), this is a no-op -- the slow *-smi calls only ever run
##   once per invocation.
## - If TYPE was set explicitly (by the user, e.g. `TYPE=nvidia` on the command
##   line via setvar) but not yet validated, verify it's actually available on
##   this hardware and hard-error if not (e.g. TYPE=nvidia with no NVIDIA GPU).
##   TYPE=cpu is always valid (that's how you force a CPU-only run on a GPU
##   node). This makes an explicit, incompatible TYPE request fail loudly
##   instead of silently running the wrong code path.
## - If TYPE was not set at all, auto-detect it. This path can never error:
##   it prefers whichever GPU vendor's *-smi succeeds, and falls back to cpu.
detect_gpu() {
    if [[ -n $TYPE ]]; then
        if [[ -n $TYPE_VALIDATED ]]; then
            return 0
        fi
        case $TYPE in
            nvidia )
                if ! nvidia-smi &> /dev/null; then
                    export GPU_PRESENT=0
                fi
                ;;
            amd )
                if ! rocm-smi &> /dev/null; then
                    export GPU_PRESENT=0
                fi
                ;;
            cpu )
                : # always valid -- e.g. forcing a CPU-only run on a GPU node
                ;;
            * )
                echo "ERROR: unknown TYPE=${TYPE} (expected cpu, amd, or nvidia)." >&2
                exit 1
                ;;
        esac
        export TYPE_VALIDATED=1
        return 0
    fi

    export TYPE=cpu
    if rocm-smi &> /dev/null; then
        export TYPE=amd
    elif nvidia-smi &> /dev/null; then
        export TYPE=nvidia
    fi
    export TYPE_VALIDATED=1
}

## gpu_build_env sets up GPU_HOME/PATH/LD_LIBRARY_PATH/GPU_ARCH and seeds
## CMAKE_FLAGS with the flags common to every test's build.sh. Callers should
## append their own test-specific CMAKE_FLAGS after calling this.
gpu_build_env() {
    detect_gpu
    if [[ $GPU_PRESENT == 0 ]]; then
        echo "NON-GPU node for build ${TYPE}."
        echo "Continuing build with default ALL ARCHITECTURES."
        return 0
    fi
    case $TYPE in
        amd )
            export HIP_ARCH=$(get_gpu_arch $TYPE)
            export AMD_ARCH="AMD_${HIP_ARCH^^}"
            ;;
        nvidia )
            export CUDA_ARCH=$(get_gpu_arch $TYPE)
            case ${CUDA_ARCH:0:1} in
                6)
                    nvarch=PASCAL # You're SOL if it's TURING
                    ;;
                7)
                    nvarch=VOLTA # You're SOL if it's TURING
                    ;;
                8)
                    nvarch=AMPERE # OR ADA.
                    ;;
                9)
                    nvarch=HOPPER
                    ;;
                1)
                    nvarch=BLACKWELL
                    ;;
                *)
                ;;
            esac
            export NVIDIA_ARCH="${nvarch}${CUDA_ARCH}"
            ;;
    esac
}

gpu_run_env() {
    detect_gpu
    if [[ $GPU_PRESENT == 0 ]]; then
        echo "Running ${TYPE} container on node without ${TYPE} GPUs won't work."
        exit 1
    fi
    CTR_GPU_ARGS=""
    NGPUSYS=64 # ACTUALLY CPU.
    case $TYPE in
        amd )
            CTR_GPU_ARGS=" --rocm"
            NGPUSYS=$(amd-smi list | grep -c 'GPU:')
            ;;
        nvidia )
            CTR_GPU_ARGS=" --nv --bind /dev/hfi1_gdr,/dev/gdrdrv"
            NGPUSYS=$(nvidia-smi -q | awk '/Attached G/ {print $NF}')
            ;;
    esac
    export CTR_GPU_ARGS NGPUSYS
}

apptainer_build() {
    cntr_title=$1
    IMG_DIR=${ROOT_DIR}/image_files
    mkdir -p ${IMG_DIR}
    docker_path="docker-daemon://${cntr_title}"
    apptainer_title=$(echo $cntr_title | tr ':' '_')
    image_file="${IMG_DIR}/${apptainer_title}.sif"
    echo $image_file
    if [[ (-f $image_file) ]]; then
        if [[ ($REBUILD == 1) ]]; then
            rm -rf $image_file
        else
            return 0
        fi
    fi
    apptainer build $image_file $docker_path
}

## cmake_it wraps the cmake/make/make-install sequence common to every
## test's build.sh. Call as: cmake_it $CMAKE_FLAGS $SRC
## (CMAKE_FLAGS expands unquoted into multiple -D... words followed by the
## source dir as the last word; cmake_it just forwards everything to cmake).
cmake_it() {
    echo "--PATH--"
    empath $PATH
    echo "--LIBRARIES--"
    empath $LD_LIBRARY_PATH
    echo "cmake $@"
    cmake "$@"
    make -j 16
    make -j 16 install
}

