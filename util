#!/usr/bin/env bash

## util is only ever sourced by build.sh/run.sh (root dispatchers) or by an
## examples/<test>/*.sh script running standalone. Either caller guarantees
## ROOT_DIR is already set before sourcing this file.

export SRC_DIR=${ROOT_DIR}/src/${NAME}
export IMAGE_DIR=${ROOT_DIR}/image_files
export RESULTS_DIR=${ROOT_DIR}/results/${NAME}

gcl() {
    git clone --recurse-submodules $1
}

get_pkgs() {
    while [[ $# -gt 0 ]]; do
        pkg=$1
        bname=$(basename $pkg .git)
        ext="${pkg##*.}"
        if [[ ! (-e ${PWD}/${bname}) ]]; then
            if [[ $ext == 'git' ]]; then
                echo "CLONING $pkg - ${PWD}"
                gcl $pkg
            else
                echo "GETTING $pkg - ${PWD}"
                wget $pkg
            fi
#        else
#            if [[ $ext == 'git' ]]; then
#                cd ${SRC_DIR}/${bname}
#                git pull
#                cd ${SRC_DIR}
#            fi
        fi
        shift
    done
}

get_repo_home() {
    curdir=$(realpath $1)
    if [[ -d $curdir/.git ]]; then
        echo $curdir
        return 0
    fi
    top_dir=$(dirname $curdir)
    if [[ -d $top_dir/.git ]]; then
        echo $top_dir
    else
        get_repo_home $top_dir
    fi
}

empath () {
	if [[ $# -lt 1 ]]
	then
		echo $PATH | tr : "\n" | nl -n ln
	else
		if [[ $# -lt 2 ]]
		then
			echo $1 | tr : "\n" | nl -n ln
		else
			echo $1 | tr $2 "\n" | nl -n ln
		fi
	fi
}

mkcd () {
    mkdir -p "${1}" && cd "${1}"
}

setvar() {
    while [[ $# -gt 0 ]]; do
        export $1
        shift
    done
}

pq_grid() {
    local n=$1
    awk -v n="$n" 'BEGIN{
        p = int(sqrt(n))
        while (p > 1 && n % p != 0) p--
        print p
    }'
}

set_paths() {
    type=$1
    image_str="cn-${type}-${NAME}"
    export HOST_INSTALL=${ROOT_DIR}/install/${type}
    export OFI_HOME=${HOST_INSTALL}/libfabric
    export MPI_HOME=${HOST_INSTALL}/openmpi-5.0.8

    export PATH=${MPI_HOME}/bin:${OFI_HOME}/bin:$PATH
    export LD_LIBRARY_PATH=${MPI_HOME}/lib:${OFI_HOME}/lib:$LD_LIBRARY_PATH
    export CTR_IMAGE="${IMAGE_DIR}/${image_str}_v${VER}.sif"
}

get_gpu_arch() {
    if [[ $1 == "nvidia" ]]; then
        nvidia-smi --query-gpu=compute_cap --format=csv,noheader,nounits | head -1 | tr -d '.'
    elif [[ $1 == "amd" ]]; then
        rocminfo | awk -F'gfx' '/gfx[0-9]/ {print "gfx"$2; exit}'
    else
        echo "NO GPU HERE - EXIT"
        exit 1
    fi
}

## detect_gpu sets/exports TYPE (cpu|amd|nvidia). The *-smi calls are slow, so
## this is a no-op if TYPE is already set/exported by a caller earlier in the
## process tree (e.g. the root build.sh/run.sh dispatcher).
detect_gpu() {
    if [[ -n $TYPE ]]; then
        return 0
    fi
    export TYPE=cpu
    if rocm-smi &> /dev/null; then
        export TYPE=amd
    elif nvidia-smi &> /dev/null; then
        export TYPE=nvidia
    fi
}

## gpu_build_env sets up GPU_HOME/PATH/LD_LIBRARY_PATH/GPU_ARCH and seeds
## CMAKE_FLAGS with the flags common to every test's build.sh. Callers should
## append their own test-specific CMAKE_FLAGS after calling this.
gpu_build_env() {
    detect_gpu
    CMAKE_FLAGS=""
    case $TYPE in
        amd )
            export GPU_HOME=/opt/rocm
            export PATH=${GPU_HOME}/bin:${PATH}
            export LD_LIBRARY_PATH=${GPU_HOME}/lib:${LD_LIBRARY_PATH}
            export GPU_ARCH=$(get_gpu_arch $TYPE)
            CMAKE_FLAGS="-DROCM_PATH=${ROCM_HOME}"
            ;;
        nvidia )
            export GPU_HOME=/nfs-scratch/sw/cuda/13.1.0_590.44.01
            export PATH=${GPU_HOME}/bin:${PATH}
            export LD_LIBRARY_PATH=${GPU_HOME}/lib64:${LD_LIBRARY_PATH}
            export GPU_ARCH=$(get_gpu_arch $TYPE)
            CMAKE_FLAGS="-DCMAKE_CUDA_ARCHITECTURES=${GPU_ARCH}"
            export NVCC_APPEND_FLAGS="-forward-unknown-to-host-compiler --expt-relaxed-constexpr"
            ;;
    esac
    export CMAKE_FLAGS
}

## gpu_run_env sets up GPU_HOME/LD_LIBRARY_PATH and seeds CTR_GPU_ARGS with
## the apptainer flags needed to expose the GPU (and, for nvidia, the OPX
## GDR devices) inside the container. Callers append CTR_GPU_ARGS to their
## own ctr_args.
gpu_run_env() {
    detect_gpu
    CTR_GPU_ARGS=""
    case $TYPE in
        amd )
            CTR_GPU_ARGS=" --rocm"
            export GPU_HOME=/opt/rocm
            export LD_LIBRARY_PATH=${GPU_HOME}/lib:${LD_LIBRARY_PATH}
            ;;
        nvidia )
            CTR_GPU_ARGS=" --nv --bind /dev/hfi1_gdr,/dev/gdrdrv"
            export GPU_HOME=/nfs-scratch/sw/cuda/13.1.0_590.44.01
            export LD_LIBRARY_PATH=${GPU_HOME}/lib64:${LD_LIBRARY_PATH}
            ;;
    esac
    export CTR_GPU_ARGS GPU_HOME
}

## cmake_it wraps the cmake/make/make-install sequence common to every
## test's build.sh. Call as: cmake_it $CMAKE_FLAGS $SRC
## (CMAKE_FLAGS expands unquoted into multiple -D... words followed by the
## source dir as the last word; cmake_it just forwards everything to cmake).
cmake_it() {
    echo "--PATH--"
    empath $PATH
    echo "--LIBRARIES--"
    empath $LD_LIBRARY_PATH
    echo "cmake $@"
    cmake "$@"
    make -j 16
    make -j 16 install
}