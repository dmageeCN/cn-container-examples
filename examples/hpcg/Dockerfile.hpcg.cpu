FROM ghcr.io/dmageecn/cn-cpu:latest

ARG TEST_NAME=hpcg
ARG REPO_NAME=hpcg
# COPY src/common/ ${SRC_DIR}/
ARG SRC_DIR=/usr/local/src
ARG BUILD_DIR=/usr/local/build
ARG INSTALL_DIR=/usr/local
ARG OMPI_VER=5.0.8
ARG ROOT_HOME=/root
ARG OPATH=${PATH}
ARG OLIB=${LD_LIBRARY_PATH}

COPY src/${TEST_NAME}/ ${SRC_DIR}/

ENV OFI_HOME=${INSTALL_DIR}/libfabric
ENV MPI_HOME=${INSTALL_DIR}/openmpi-${OMPI_VER}
ENV PATH="${OFI_HOME}/bin:${MPI_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OFI_HOME}/lib:${MPI_HOME}/lib:${LD_LIBRARY_PATH}"

## Upstream hpcg-benchmark/hpcg's CMakeLists.txt has no install() rules at
## all (it only ever shipped Make/Autoconf-based installs), and it builds
## MPI/OpenMP support off by default -- turn both on here since this is the
## multi-node/multi-core CPU path. There's also no CMAKE_INSTALL_PREFIX to
## set; the built xhpcg binary lands directly in the (out-of-source) build
## dir, so we copy it into INSTALL_DIR/${REPO_NAME} ourselves below.
ARG CMAKE_FLAGS="-DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DHPCG_ENABLE_MPI=ON \
    -DHPCG_ENABLE_OPENMP=ON \
    ${SRC_DIR}/${REPO_NAME}"

ENV CC=mpicc
ENV CXX=mpicxx
ENV FC=mpifort
ENV CFLAGS="-w"
ENV CXXFLAGS="-w"
ENV FCFLAGS="-w"
ENV LDFLAGS="-Wl,--enable-new-dtags -w"

WORKDIR /tmp/build
RUN cmake ${CMAKE_FLAGS} && \
    make -j 16

RUN mkdir -p ${INSTALL_DIR}/${REPO_NAME}/bin && \
    cp /tmp/build/xhpcg ${INSTALL_DIR}/${REPO_NAME}/bin/ && \
    cp ${SRC_DIR}/${REPO_NAME}/bin/hpcg.dat ${INSTALL_DIR}/${REPO_NAME}/

ENV PATH=${OPATH}
ENV LD_LIBRARY_PATH=${OLIB}
ENV CC=
ENV CXX=
ENV FC=
ENV CFLAGS=
ENV CXXFLAGS=
ENV FCFLAGS=
ENV LDFLAGS=

WORKDIR /workspace
