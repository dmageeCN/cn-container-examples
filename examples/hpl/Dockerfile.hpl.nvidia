FROM ghcr.io/dmageecn/cn-nvidia:latest

ARG TEST_NAME=hpl
ARG REPO_NAME=rocHPL
# COPY src/common/ ${SRC_DIR}/
ARG SRC_DIR=/usr/local/src
ARG BUILD_DIR=/usr/local/build
ARG INSTALL_DIR=/usr/local
ARG OMPI_VER=5.0.8
ARG ROOT_HOME=/root
ARG OPATH=${PATH}
ARG OLIB=${LD_LIBRARY_PATH}

COPY src/${TEST_NAME}/ ${SRC_DIR}/

RUN dnf clean all

ENV OFI_HOME=${INSTALL_DIR}/libfabric
ENV MPI_HOME=${INSTALL_DIR}/openmpi-${OMPI_VER}
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_STUBS=${CUDA_HOME}/lib64/stubs
ENV PATH="${OFI_HOME}/bin:${MPI_HOME}/bin:${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OFI_HOME}/lib:${MPI_HOME}/lib:${CUDA_HOME}/lib64:${CUDA_STUBS}:${LD_LIBRARY_PATH}"
ENV NVCC_APPEND_FLAGS="-forward-unknown-to-host-compiler --expt-relaxed-constexpr"

## This repo is meant to be built by the public on whatever NVIDIA GPU they
## have (Volta through Blackwell), not just Cornelis's own H100s -- default
## to a multi-arch fat binary spanning several recent generations so no
## --build-arg is required for the common case. Override with e.g.
## `--build-arg CUDA_ARCH=90` to build faster for a single known GPU.
ARG CUDA_ARCH="75;80;86;89;90;100;120"

ARG CMAKE_FLAGS="-DCMAKE_VERBOSE_MAKEFILE=ON \
-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${REPO_NAME} \
-DHPL_MPI_DIR=${MPI_HOME} \
-DCUDAToolkit_ROOT=${CUDA_HOME} \
-DCMAKE_BUILD_TYPE=Release \
-DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
${SRC_DIR}/${REPO_NAME}"

ENV CC=mpicc
ENV CXX=mpicxx
ENV FC=mpifort
ENV CFLAGS="-w"
ENV CXXFLAGS="-w"
ENV FCFLAGS="-w"
ENV LDFLAGS="-Wl,--enable-new-dtags -w"

WORKDIR ${SRC_DIR}/${REPO_NAME}
RUN git checkout cuda_port

WORKDIR /tmp/build
RUN cmake ${CMAKE_FLAGS} && \
    make && \
    make install

ENV PATH=${OPATH}
ENV LD_LIBRARY_PATH=${OLIB}
ENV CC=
ENV CXX=
ENV FC=
ENV CFLAGS=
ENV CXXFLAGS=
ENV FCFLAGS=
ENV LDFLAGS=

WORKDIR /workspace
