FROM ghcr.io/dmageecn/cn-nvidia:latest

ARG TEST_NAME=parthenon
ARG REPO_NAME=parthenon
# COPY src/common/ ${SRC_DIR}/
ARG SRC_DIR=/usr/local/src
ARG BUILD_DIR=/usr/local/build
ARG INSTALL_DIR=/usr/local
ARG OMPI_VER=5.0.8
ARG ROOT_HOME=/root
ARG OPATH=${PATH}
ARG OLIB=${LD_LIBRARY_PATH}

COPY src/${TEST_NAME}/ ${SRC_DIR}/

## The CMake shipped by the base OS is too old for Parthenon (requires
## >= 3.16, but newer is safer) -- pull a fresh one from dnf, matching the
## other examples' convention.
RUN dnf install -y cmake && \
    dnf clean all

ENV OFI_HOME=${INSTALL_DIR}/libfabric
ENV MPI_HOME=${INSTALL_DIR}/openmpi-${OMPI_VER}
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_STUBS=${CUDA_HOME}/lib64/stubs
ENV PATH="${OFI_HOME}/bin:${MPI_HOME}/bin:${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OFI_HOME}/lib:${MPI_HOME}/lib:${CUDA_HOME}/lib64:${CUDA_STUBS}:${LD_LIBRARY_PATH}"
ENV NVCC_APPEND_FLAGS='-forward-unknown-to-host-compiler --expt-relaxed-constexpr'

WORKDIR ${SRC_DIR}/${REPO_NAME}
RUN git checkout v25.12

## Kokkos's CUDA backend requires CMAKE_CXX_COMPILER to be either Clang or
## its own nvcc_wrapper (a thin bash wrapper around nvcc + a host compiler,
## shipped in the Kokkos submodule) -- plain mpicxx will not do here, unlike
## GROMACS's CUDA build which handles its own nvcc invocation internally.
## NVCC_WRAPPER_DEFAULT_COMPILER tells nvcc_wrapper which host compiler to
## forward non-CUDA flags to, so MPI headers/libs still resolve correctly.
##
## Unlike the other (non-Kokkos) examples in this repo, Kokkos can only
## target ONE GPU architecture per build -- enabling more than one
## Kokkos_ARCH_* option at once is a hard FATAL_ERROR upstream, and its own
## build-time auto-detection requires a real, matching GPU physically
## present on the machine running `docker build` (not a safe assumption for
## a publicly-built image). So NVIDIA_ARCH is a single explicit
## Kokkos_ARCH_* suffix (see external/Kokkos/cmake/kokkos_arch.cmake for the
## full list, e.g. VOLTA70, AMPERE80, ADA89, HOPPER90, BLACKWELL100),
## defaulting to H100 but overridable via `--build-arg NVIDIA_ARCH=...`.
ARG NVIDIA_ARCH=HOPPER90
ARG CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release \
    -DPARTHENON_DISABLE_HDF5=ON \
    -DPARTHENON_ENABLE_PYTHON_MODULE_CHECK=OFF \
    -DREGRESSION_GOLD_STANDARD_SYNC=OFF \
    -DPARTHENON_ENABLE_TESTING=OFF \
    -DKokkos_ENABLE_OPENMP=ON \
    -DKokkos_ENABLE_CUDA=ON \
    -DKokkos_ARCH_${NVIDIA_ARCH}=ON \
    ${SRC_DIR}/${REPO_NAME}"

ENV CC=mpicc
ENV CXX=${SRC_DIR}/${REPO_NAME}/external/Kokkos/bin/nvcc_wrapper
ENV FC=mpifort
ENV NVCC_WRAPPER_DEFAULT_COMPILER=mpicxx

WORKDIR /tmp/build
RUN cmake ${CMAKE_FLAGS} && \
    make -j 16

## Parthenon's own CMakeLists.txt only installs the parthenon library, not
## the benchmarks -- benchmarks/burgers/CMakeLists.txt has no install()
## rule, so the burgers-benchmark executable has to be copied by hand
## (same pattern as hpcg-cpu's xhpcg). Ship the reference .pin input deck
## alongside it.
RUN mkdir -p ${INSTALL_DIR}/${REPO_NAME}/bin && \
    cp /tmp/build/benchmarks/burgers/burgers-benchmark ${INSTALL_DIR}/${REPO_NAME}/bin/ && \
    cp ${SRC_DIR}/${REPO_NAME}/benchmarks/burgers/burgers.pin ${INSTALL_DIR}/${REPO_NAME}/

ENV PATH=${OPATH}
ENV LD_LIBRARY_PATH=${OLIB}
ENV CC=
ENV CXX=
ENV FC=
ENV NVCC_WRAPPER_DEFAULT_COMPILER=

WORKDIR /workspace
