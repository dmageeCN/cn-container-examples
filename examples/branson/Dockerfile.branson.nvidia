ARG BASE_REGISTRY=ghcr.io/dmageecn/
ARG BASE_VERSION=latest
FROM ${BASE_REGISTRY}cn-nvidia:${BASE_VERSION}

ARG TEST_NAME=branson
ARG REPO_NAME=branson
# COPY src/common/ ${SRC_DIR}/
ARG SRC_DIR=/usr/local/src
ARG BUILD_DIR=/usr/local/build
ARG INSTALL_DIR=/usr/local
ARG OMPI_VER=5.0.8
ARG ROOT_HOME=/root
ARG OPATH=${PATH}
ARG OLIB=${LD_LIBRARY_PATH}

COPY src/${TEST_NAME}/ ${SRC_DIR}/

## Branson's bundled FindMETIS.cmake searches for plain metis.h/libmetis.so.
## The metis64-devel package (64-bit-integer METIS variant) ships differently
## named files (metis64.h/libmetis64.so) that FindMETIS.cmake never finds --
## install the plain metis-devel package instead so the expected names exist.
RUN dnf install -y metis-devel && \
    dnf clean all

ENV OFI_HOME=${INSTALL_DIR}/libfabric
ENV MPI_HOME=${INSTALL_DIR}/openmpi-${OMPI_VER}
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_STUBS=${CUDA_HOME}/lib64/stubs
ENV PATH="${OFI_HOME}/bin:${MPI_HOME}/bin:${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OFI_HOME}/lib:${MPI_HOME}/lib:${CUDA_HOME}/lib64:${CUDA_STUBS}:${LD_LIBRARY_PATH}"

## Unlike the other examples, Branson's CMakeLists.txt lives under src/,
## not at the repo root.
WORKDIR ${SRC_DIR}/${REPO_NAME}

## No release tag includes GPU support (it landed after the last tag was
## cut) -- build from develop as cloned by getsrc.sh.

## src/CMakeLists.txt:120 unconditionally hardcodes
## `set(CMAKE_CUDA_ARCHITECTURES 70 75 80 86 90)` via a plain (non-cache)
## set(), BEFORE add_executable(BRANSON ...) is called further down. CMake
## snapshots a target's CUDA_ARCHITECTURES property from the variable's
## value at the moment the target is created, so this hardcode wins over
## any -DCMAKE_CUDA_ARCHITECTURES=... passed on the command line -- the
## "real" override later in the file (inside the USE_CUDA branch) runs
## AFTER add_executable, so it's too late to have any effect. No -D flag
## can beat a plain set() that runs first; strip the hardcoded line so our
## CUDA_ARCH/CMAKE_CUDA_ARCHITECTURES build-args actually take effect.
RUN sed -i '/^set(CMAKE_CUDA_ARCHITECTURES 70 75 80 86 90)$/d' src/CMakeLists.txt

## Branson's CMakeLists.txt sets CMAKE_CUDA_HOST_COMPILER from
## CMAKE_CXX_COMPILER directly (unlike Kokkos-based Parthenon, which
## requires nvcc_wrapper/Clang), so plain mpicxx works unchanged as CXX
## here. USE_GPU is a separate switch from USE_CUDA -- both are required to
## actually turn on the CUDA code path and its `enable_language(CUDA)`
## setup.
##
## CUDA_ARCH flows straight into CMake's native (multi-value-capable)
## CMAKE_CUDA_ARCHITECTURES, and Branson does no validation of its own, so
## -- unlike Parthenon/Kokkos -- a broad multi-arch fat binary is possible
## here. Default spans Volta through Blackwell so this builds and runs on
## whatever NVIDIA GPU a public user happens to have, without requiring a
## matching GPU on the build host; override with e.g.
## `--build-arg CUDA_ARCH=90` for a single-arch/faster build.
ARG CUDA_ARCH="75;80;86;89;90;100;120"

## Branson's own FindOpenMP fallback (src/CMakeLists.txt) only special-cases
## the Cray compiler wrapper and otherwise hard FATAL_ERRORs if stock CMake
## FindOpenMP can't identify the compiler -- fragile on non-GNU/Clang
## toolchains (e.g. Intel oneAPI's LLVM-based icx/icpx). Pre-seed OpenMP's
## own cache variables so FindOpenMP short-circuits its compiler-guessing
## entirely and just accepts these; override OPENMP_FLAG/OPENMP_LIB via
## --build-arg for a different compiler (e.g. -fiopenmp / iomp5 for icx).
## CMake's FindOpenMP tracks CUDA as its own separate language once
## enable_language(CUDA) has run (see `Languages: C;CUDA;CXX` in build logs),
## so OpenMP_CUDA_FLAGS/OpenMP_CUDA_LIB_NAMES must be pre-seeded too, or the
## aggregate OpenMP_FOUND stays false even though C/CXX detection succeeded.
ENV CC=mpicc
ENV CXX=mpicxx
ENV FC=mpifort
ENV CFLAGS="-w"
ENV CXXFLAGS="-w"
ENV FCFLAGS="-w"
ENV LDFLAGS="-Wl,--enable-new-dtags -w"
ENV NVCCFLAGS="-w"

ARG OPENMP_FLAG="-fopenmp"
ARG OPENMP_LIB="gomp"
ARG CMAKE_FLAGS="-DCMAKE_VERBOSE_MAKEFILE=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${REPO_NAME} \
    -DBUILD_TESTING=OFF \
    -DUSE_OPENMP=ON \
    -DOpenMP_C_FLAGS=${OPENMP_FLAG} \
    -DOpenMP_C_LIB_NAMES=${OPENMP_LIB} \
    -DOpenMP_CXX_FLAGS=${OPENMP_FLAG} \
    -DOpenMP_CXX_LIB_NAMES=${OPENMP_LIB} \
    -DOpenMP_${OPENMP_LIB}_LIBRARY=${OPENMP_LIB} \
    -DOpenMP_CUDA_FLAGS=${OPENMP_FLAG} \
    -DOpenMP_CUDA_LIB_NAMES=${OPENMP_LIB} \
    -DUSE_CUDA=ON \
    -DUSE_GPU=ON \
    -DCUDA_ARCH=${CUDA_ARCH} \
    -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
    -DCMAKE_CUDA_HOST_COMPILER=$CXX \
    # -DCMAKE_CUDA_FLAGS='-w ' \
    ${SRC_DIR}/${REPO_NAME}/src"

WORKDIR /tmp/build
RUN cmake ${CMAKE_FLAGS} && \
    make -j 16 && \
    make -j 16 install

## Branson's top-level CMakeLists.txt does install() the BRANSON binary
## itself, but not the sample XML input decks under inputs/ -- copy those
## by hand so the run wrapper has something to point at.
RUN mkdir -p ${INSTALL_DIR}/${REPO_NAME}/inputs && \
    cp ${SRC_DIR}/${REPO_NAME}/inputs/*.xml ${INSTALL_DIR}/${REPO_NAME}/inputs/

ENV PATH=${OPATH}
ENV LD_LIBRARY_PATH=${OLIB}
ENV CC=
ENV CXX=
ENV FC=
ENV CFLAGS=
ENV CXXFLAGS=
ENV FCFLAGS=
ENV LDFLAGS=

WORKDIR /workspace
